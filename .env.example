# ============================================================================
# KAZIPOA — Environment Configuration
# Copy this file to .env for local dev, or paste these into your host's
# environment-variable settings for production (Railway, Render, etc).
# ============================================================================

# ---- REQUIRED: Core ----------------------------------------------------
NODE_ENV=production

# MySQL connection string (drizzle-orm uses mysql2 — this is NOT Postgres).
# Format: mysql://user:password@host:port/database
# Free/managed options: PlanetScale, Railway MySQL plugin, Aiven, a Hostinger/DO MySQL instance.
DATABASE_URL=mysql://user:password@host:3306/kazipoa

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The public URL your site will be reachable at once deployed.
# Used in emails, sitemap.xml, robots.txt, and interview invite links.
APP_BASE_URL=https://your-domain.example.com

# ---- REQUIRED: Auth ------------------------------------------------------
# The app ships with its own email/password auth (server/customAuth.ts) that
# does NOT depend on any third-party platform. Keep this "true" unless you
# are wiring up Manus's OAuth (see note below).
KAZIPOA_CUSTOM_AUTH_ENABLED=true

# ---- OPTIONAL: Transactional email (Postmark) ----------------------------
# Without this, status-change and interview-invite emails are skipped
# (logged as "email skipped") but the app still works.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=notifications@your-domain.example.com
POSTMARK_MESSAGE_STREAM=outbound

# ---- OPTIONAL: SMS (used for urgent-vacancy alerts & interview texts) ----
SMS_PROVIDER_ENABLED=false
SMS_PROVIDER_BASE_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# ---- OPTIONAL: M-Pesa callback verification -------------------------------
MPESA_CALLBACK_SECRET=

# ---- REQUIRED: File storage (Cloudflare R2) --------------------------------
# CV uploads, certificates, profile/company photos, and payment receipts are
# stored in a Cloudflare R2 bucket (S3-compatible, generous free tier, no
# egress fees). Setup:
#   1. cloudflare.com dashboard -> R2 -> Create bucket. Name it e.g. "kazipoa".
#   2. R2 -> Manage API Tokens -> Create API Token -> permissions: Object
#      Read & Write, scoped to that bucket. Copy the Access Key ID, Secret
#      Access Key, and Account ID shown there.
#   3. Paste them below.
# Full walkthrough: docs/DEPLOY.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kazipoa

# Optional: if you turn on "Public Development URL" (or attach a custom
# domain) for the bucket in the R2 dashboard, paste it here (no trailing
# slash). Public files (logos, hero images) are then served directly from R2
# instead of proxied through your server. Private files (CVs, receipts)
# always use signed URLs regardless of this setting.
R2_PUBLIC_URL=

# ============================================================================
# ⚠️  MANUS-PLATFORM-ONLY FEATURES (optional — everything else works without these)
# ----------------------------------------------------------------------------
# This app was originally built on Manus (an AI app-builder). A few AI/
# convenience features still call Manus's own hosted backend ("Forge")
# instead of a generic provider:
#   - AI chat box / vacancy description assist   -> server/_core/llm.ts
#   - AI image generation                        -> server/_core/imageGeneration.ts
#   - Google Maps proxy (location picker)         -> server/_core/map.ts
#   - Voice transcription                         -> server/_core/voiceTranscription.ts
#
# (File storage no longer needs these — it now runs on R2, configured above.)
#
# If you still have an active Manus project, these values are in your Manus
# project settings. Otherwise leave them blank: those specific features will
# show a clear "not configured" message instead of crashing the app.
# ============================================================================
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Legacy OAuth (Manus login) — leave blank if using KAZIPOA_CUSTOM_AUTH_ENABLED
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
